---
import HeaderBrand from "./HeaderBrand.astro";
import HeaderNav from "./HeaderNav.astro";
import HeaderSocials from "./HeaderSocials.astro";
import HeaderCta from "./HeaderCta.astro";
import HeaderMenuToggle from "./HeaderMenuToggle.astro";
import HeaderMobileMenu from "./HeaderMobileMenu.astro";
import { DEFAULT_NAV_LINKS, DEFAULT_SOCIAL_LINKS } from "./headerData";
import type { HeaderProps } from "./types";

interface Props extends HeaderProps {}

const {
  brandName = "Martín Hernández",
  navLinks = DEFAULT_NAV_LINKS,
  socialLinks = DEFAULT_SOCIAL_LINKS,
  ctaLabel = "Hablemos",
  ctaHref = "#contacto",
  class: className = "",
} = Astro.props;
---

<header
  id="main-header"
  class:list={[
    "sticky top-0 border-b border-zinc-800 bg-zinc-950 z-50 transition-all duration-300",
    className,
  ]}
>
  <div
    class="max-w-7xl mx-auto px-6 sm:px-10 h-17 sm:h-20 flex items-center justify-between gap-6"
  >
    <HeaderBrand name={brandName} />
    <HeaderNav links={navLinks} />
    <div class="flex items-center gap-2.5 sm:gap-4">
      <HeaderSocials socials={socialLinks} />
      <div class="hidden sm:block w-px h-4 bg-zinc-800" aria-hidden="true">
      </div>
      <HeaderCta label={ctaLabel} href={ctaHref} />
      <HeaderMenuToggle />
    </div>
  </div>
</header>
<HeaderMobileMenu links={navLinks} socials={socialLinks} />

<script>
  const header = document.getElementById("main-header");
  const toggleBtn = document.getElementById("menu-toggle");
  const mobileMenu = document.getElementById("mobile-menu");

  const handleScroll = () => {
    if (!header) return;
    if (window.scrollY > 20) {
      header.classList.add(
        "bg-zinc-950/80",
        "backdrop-blur-xl",
        "border-zinc-800/80",
        "shadow-[0_4px_30px_rgba(0,0,0,0.85)]",
      );
      header.classList.remove("bg-transparent", "border-transparent");
    } else {
      header.classList.remove(
        "bg-zinc-950/80",
        "backdrop-blur-xl",
        "border-zinc-800/80",
        "shadow-[0_4px_30px_rgba(0,0,0,0.85)]",
      );
      header.classList.add("bg-transparent", "border-transparent");
    }
  };

  window.addEventListener("scroll", handleScroll, { passive: true });
  handleScroll();

  if (toggleBtn && mobileMenu) {
    const setMenuOpen = (open: boolean) => {
      mobileMenu.classList.toggle("is-open", open);
      mobileMenu.setAttribute("aria-hidden", String(!open));
      toggleBtn.classList.toggle("is-active", open);
      toggleBtn.setAttribute("aria-expanded", String(open));
      toggleBtn.setAttribute(
        "aria-label",
        open ? "Cerrar menú de navegación" : "Abrir menú de navegación",
      );
      if (open) {
        document.body.classList.add("overflow-hidden");
        header?.classList.add("bg-zinc-950");
      } else {
        document.body.classList.remove("overflow-hidden");
        handleScroll();
      }
    };

    toggleBtn.addEventListener("click", () => {
      const isOpen = mobileMenu.classList.contains("is-open");
      setMenuOpen(!isOpen);
    });

    mobileMenu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        setMenuOpen(false);
      });
    });

    window.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && mobileMenu.classList.contains("is-open")) {
        setMenuOpen(false);
      }
    });

    window.addEventListener("resize", () => {
      if (
        window.innerWidth >= 768 &&
        mobileMenu.classList.contains("is-open")
      ) {
        setMenuOpen(false);
      }
    });
  }
</script>
