---
import type { NavLink } from "@types";
import { NAV_LINKS } from "@data/navigation";

interface Props {
  links?: NavLink[];
  class?: string;
}

const { links = NAV_LINKS, class: className = "" } = Astro.props;
---

<nav
  class:list={["hidden md:flex items-center gap-7 lg:gap-9", className]}
  aria-label="Navegación principal"
>
  {
    links.map((link) => (
      <a
        href={link.href}
        class="header-nav-link text-sm font-medium text-zinc-400 hover:text-white transition-colors relative py-1 group"
      >
        <span>{link.label}</span>
      </a>
    ))
  }
</nav>
