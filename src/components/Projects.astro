---
import snapcify from "../assets/snapcify.webp";
import socializeNow from "../assets/socialize-now.webp";
import ProjectCard from "./cards/ProjectCard.astro";
import lbs from "../assets/lbs.png";
import demopos from "../assets/demopos.webp";
---

<section id="projects" class="py-20 lg:py-32">
  <h2 class="text-white font-bold text-4xl pt-10">Projects & Work</h2>
  <p class="text-gray-400 mt-4 text-lg">
    Some of the projects and work I've build.
  </p>
  <div class="grid grid-cols-fluid gap-5 pt-10">
    <ProjectCard
      title="Socialize Now"
      preview="https://merry-capybara-cd3821.netlify.app/"
      description="Social platform for posting everything you want!"
      technologies={["Nodejs •", "Express •", "React •", "Material UI"]}
      repo="https://github.com/stevenht19/mui-socializenow"
      path={socializeNow}
    />
    <ProjectCard
      title="Snapcify"
      description="A web music player with non commercial purposes."
      technologies={["HTML/CSS •", "React •", "Typescript"]}
      repo="https://github.com/stevenht19/snapcify-web-music-player"
      path={snapcify}
    />
    <ProjectCard
      title="Language Bridge Solutions"
      preview="https://www.languagebridgesolutions.com"
      description="Website for Language Bridge Solutions Company."
      technologies={["Nextjs"]}
      path={lbs}
    />
    <ProjectCard
      title="POS Demo"
      preview="https://demo-pos-app.vercel.app"
      description="Peruvian Restaurant POS demo"
      technologies={["Typescript •", "Nextjs •", "TailwindCSS"]}
      repo="https://github.com/stevenht19/demo-pos-app"
      path={demopos}
    />
  </div>
</section>
