---
interface Props {
  title: string;
  description: string;
  class?: string;
}

const { title, description, class: className = "" } = Astro.props;
---

<div class:list={[className]}>
  <h3
    class="mt-4 font-display text-xl font-extrabold tracking-tight text-white transition-colors duration-300 sm:text-2xl"
  >
    {title}
  </h3>

  <p
    class="mt-3 text-[15px] leading-relaxed text-zinc-400 transition-colors duration-300 group-hover:text-zinc-300"
  >
    {description}
  </p>
</div>