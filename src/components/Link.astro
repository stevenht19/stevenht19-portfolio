---
const { path, text, my } = Astro.props;
---

<a
  href={path || "#"}
  class={`text-white font-medium flex items-center hover:underline${
    my ? " mt-5 mb-14" : ""
  }`}
>
  {text}
  <div>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="22"
      height="22"
      viewBox="0 0 24 24"
      class="fill-blue-200 translate-y-0.5"
    >
      <path
        d="M10.707 17.707 16.414 12l-5.707-5.707-1.414 1.414L13.586 12l-4.293 4.293z"
      ></path>
    </svg>
  </div>
</a>
