---
interface Props {
  href: string;
  label: string;
  icon?: "external" | "arrow-down";
  variant?: "primary" | "white";
  target?: string;
  rel?: string;
  class?: string;
}

const {
  href,
  label,
  icon = "external",
  variant = "white",
  target,
  rel,
  class: className = "",
} = Astro.props;

const isBlank = target === "_blank";
const resolvedRel = isBlank ? rel || "noopener noreferrer" : rel;

const variantStyles =
  variant === "primary"
    ? "hover:border-primary/40 hover:bg-primary/10 hover:text-primary"
    : "hover:border-white/25 hover:bg-white/4 hover:text-white";
---

<a
  href={href}
  target={target}
  rel={resolvedRel}
  data-magnetic
  class:list={[
    "group/btn inline-flex items-center gap-2.5 rounded-full border border-white/10 bg-transparent px-5 py-3 text-sm font-medium text-zinc-400 transition-all duration-300 will-change-transform",
    variantStyles,
    className,
  ]}
>
  <span>{label}</span>

  {
    icon === "arrow-down" && (
      <svg
        class="h-3.5 w-3.5 transition-transform duration-300 group-hover/btn:translate-y-0.5"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <line x1="12" y1="5" x2="12" y2="19" />
        <polyline points="19 12 12 19 5 12" />
      </svg>
    )
  }

  {
    icon === "external" && (
      <svg
        class="h-3.5 w-3.5 transition-transform duration-300 group-hover/btn:-translate-y-0.5 group-hover/btn:translate-x-0.5"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M7 17L17 7" />
        <path d="M7 7h10v10" />
      </svg>
    )
  }
</a>
