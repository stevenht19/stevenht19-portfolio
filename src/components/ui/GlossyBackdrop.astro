---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<div
  class:list={[
    "pointer-events-none absolute inset-0 z-0 overflow-hidden",
    className,
  ]}
  aria-hidden="true"
>
  <div
    class="absolute inset-0 opacity-60"
    style="background-image:linear-gradient(to right,rgba(255,255,255,0.045) 1px,transparent 1px),linear-gradient(to bottom,rgba(255,255,255,0.045) 1px,transparent 1px);background-size:64px 64px;"
  >
  </div>
</div>
