---
interface Props {
  label: string;
  count?: number;
  class?: string;
}

const { label, count, class: className = "" } = Astro.props;
---

<div class:list={["flex items-center gap-3", className]}>
  <span class="relative flex h-1.5 w-1.5 flex-none" aria-hidden="true">
    <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-primary"
    ></span>
  </span>
  <span
    class="text-[11px] font-semibold uppercase tracking-[0.22em] text-primary"
  >
    {label}
  </span>
  <span
    class="h-px flex-1 bg-linear-to-r from-primary/60 to-transparent"
    aria-hidden="true"></span>
  {
    !!count && (
      <span
        class="flex-none font-display text-[11px] font-extrabold tracking-[0.18em] text-zinc-500"
        aria-hidden="true"
      >
        {String(count).padStart(2, "0")}
      </span>
    )
  }
</div>
