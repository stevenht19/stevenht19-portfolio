---
interface Props {
  id?: string;
  dotColor?: string;
  activeColor?: string;
  dotSize?: number;
  gap?: number;
  proximity?: number;
  speedTrigger?: number;
  shockRadius?: number;
  shockStrength?: number;
  interactive?: boolean;
  class?: string;
}

const {
  id: customId,
  dotColor = "#232426",
  activeColor = "#d4ff00",
  dotSize = 2.5,
  gap = 24,
  proximity = 180,
  speedTrigger = 80,
  shockRadius = 220,
  shockStrength = 4,
  interactive = true,
  class: className = "",
} = Astro.props;

// Auto-generate a unique ID if none provided to avoid collisions across multiple instances
const uniqueSuffix = Math.random().toString(36).substring(2, 8);
const gridId = customId || `dot-grid-${uniqueSuffix}`;
---

<div
  id={`${gridId}-wrap`}
  data-dot-grid
  data-dot-color={dotColor}
  data-active-color={activeColor}
  data-dot-size={dotSize}
  data-gap={gap}
  data-proximity={proximity}
  data-speed-trigger={speedTrigger}
  data-shock-radius={shockRadius}
  data-shock-strength={shockStrength}
  data-interactive={interactive ? "true" : "false"}
  class:list={[
    "dot-grid-container absolute inset-0 w-full h-full overflow-hidden",
    className,
  ]}
>
  <canvas
    id={`${gridId}-canvas`}
    class="pointer-events-none absolute inset-0 block h-full w-full"
  ></canvas>
</div>

<script>
  import { gsap } from "gsap";
  import { InertiaPlugin } from "gsap/InertiaPlugin";
  import { onDomReady } from "@utils/motion";

  gsap.registerPlugin(InertiaPlugin);

  interface Dot {
    cx: number;
    cy: number;
    xOffset: number;
    yOffset: number;
    _inertiaApplied: boolean;
  }

  function hexToRgb(hex: string) {
    const m = hex.match(/^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i);
    if (!m) return { r: 82, g: 82, b: 91 };
    return {
      r: parseInt(m[1], 16),
      g: parseInt(m[2], 16),
      b: parseInt(m[3], 16),
    };
  }

  function throttle<T extends (...args: any[]) => void>(
    func: T,
    limit: number,
  ) {
    let lastCall = 0;
    return function (...args: Parameters<T>) {
      const now = performance.now();
      if (now - lastCall >= limit) {
        lastCall = now;
        func(...args);
      }
    };
  }

  const isMobile = () => {
    if (typeof window === "undefined") return false;
    return (
      window.innerWidth < 768 ||
      window.matchMedia("(max-width: 768px)").matches ||
      window.matchMedia("(hover: none)").matches ||
      window.matchMedia("(prefers-reduced-motion: reduce)").matches
    );
  };

  const initDotGrid = (wrap: HTMLElement) => {
    if (wrap.dataset.initialized === "true") return;
    wrap.dataset.initialized = "true";

    const baseColor = wrap.dataset.dotColor || "#232426";
    const activeColor = wrap.dataset.activeColor || "#d4ff00";
    const dotSize = parseFloat(wrap.dataset.dotSize || "2.5");
    const gap = parseFloat(wrap.dataset.gap || "24");
    const proximity = parseFloat(wrap.dataset.proximity || "180");
    const speedTrigger = parseFloat(wrap.dataset.speedTrigger || "80");
    const shockRadius = parseFloat(wrap.dataset.shockRadius || "220");
    const shockStrength = parseFloat(wrap.dataset.shockStrength || "4");
    const isInteractive = wrap.dataset.interactive !== "false";

    const maxSpeed = 4000;
    const resistance = 800;
    const returnDuration = 1.8;

    const baseRgb = hexToRgb(baseColor);
    const activeRgb = hexToRgb(activeColor);
    const proxSq = proximity * proximity;

    const canvas = wrap.querySelector("canvas") as HTMLCanvasElement | null;
    if (!canvas) return;

    let dots: Dot[] = [];
    let rafId = 0;
    let isVisible = true;

    const pointer = {
      x: -1000,
      y: -1000,
      vx: 0,
      vy: 0,
      speed: 0,
      lastTime: 0,
      lastX: -1000,
      lastY: -1000,
      hasMoved: false,
    };

    const circlePath =
      typeof window !== "undefined" && window.Path2D ? new Path2D() : null;
    if (circlePath) {
      circlePath.arc(0, 0, dotSize / 2, 0, Math.PI * 2);
    }

    const draw = () => {
      if (!canvas) return;
      const ctx = canvas.getContext("2d");
      if (!ctx) return;
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      const mobile = isMobile() || !isInteractive;
      const px = mobile ? -1000 : pointer.x;
      const py = mobile ? -1000 : pointer.y;

      for (let i = 0; i < dots.length; i++) {
        const dot = dots[i];
        const ox = dot.cx + dot.xOffset;
        const oy = dot.cy + dot.yOffset;
        const dx = dot.cx - px;
        const dy = dot.cy - py;
        const dsq = dx * dx + dy * dy;

        let fillStyle = baseColor;
        if (!mobile && dsq <= proxSq) {
          const dist = Math.sqrt(dsq);
          const t = 1 - dist / proximity;
          const r = Math.round(baseRgb.r + (activeRgb.r - baseRgb.r) * t);
          const g = Math.round(baseRgb.g + (activeRgb.g - baseRgb.g) * t);
          const b = Math.round(baseRgb.b + (activeRgb.b - baseRgb.b) * t);
          fillStyle = `rgb(${r},${g},${b})`;
        }

        ctx.save();
        ctx.translate(ox, oy);
        ctx.fillStyle = fillStyle;
        if (circlePath) {
          ctx.fill(circlePath);
        } else {
          ctx.beginPath();
          ctx.arc(0, 0, dotSize / 2, 0, Math.PI * 2);
          ctx.fill();
        }
        ctx.restore();
      }

      if (!mobile && isVisible) {
        rafId = requestAnimationFrame(draw);
      }
    };

    const buildGrid = (w?: number, h?: number) => {
      const width =
        w !== undefined && w > 0
          ? w
          : wrap.clientWidth || (typeof wrap.getBoundingClientRect === "function" ? wrap.getBoundingClientRect().width : 0);
      const height =
        h !== undefined && h > 0
          ? h
          : wrap.clientHeight || (typeof wrap.getBoundingClientRect === "function" ? wrap.getBoundingClientRect().height : 0);
      if (width <= 0 || height <= 0) return;

      const dpr = window.devicePixelRatio || 1;

      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      const ctx = canvas.getContext("2d");
      if (ctx) ctx.scale(dpr, dpr);

      const cell = dotSize + gap;
      const cols = Math.floor((width + gap) / cell);
      const rows = Math.floor((height + gap) / cell);

      const gridW = cell * cols - gap;
      const gridH = cell * rows - gap;

      const extraX = width - gridW;
      const extraY = height - gridH;

      const startX = extraX / 2 + dotSize / 2;
      const startY = extraY / 2 + dotSize / 2;

      const newDots: Dot[] = [];
      for (let y = 0; y < rows; y++) {
        for (let x = 0; x < cols; x++) {
          const cx = startX + x * cell;
          const cy = startY + y * cell;
          newDots.push({
            cx,
            cy,
            xOffset: 0,
            yOffset: 0,
            _inertiaApplied: false,
          });
        }
      }
      dots = newDots;

      cancelAnimationFrame(rafId);
      draw();
      if (!isMobile() && isInteractive && isVisible) {
        rafId = requestAnimationFrame(draw);
      }
    };

    const onMove = (e: MouseEvent | Touch) => {
      if (isMobile() || !isInteractive || !isVisible) return;

      const rect = canvas.getBoundingClientRect();
      const margin = proximity + 60;
      if (
        e.clientX < rect.left - margin ||
        e.clientX > rect.right + margin ||
        e.clientY < rect.top - margin ||
        e.clientY > rect.bottom + margin
      ) {
        if (pointer.hasMoved) {
          pointer.x = -1000;
          pointer.y = -1000;
          pointer.hasMoved = false;
        }
        return;
      }

      const now = performance.now();
      if (!pointer.hasMoved) {
        pointer.hasMoved = true;
        pointer.lastX = e.clientX;
        pointer.lastY = e.clientY;
        pointer.lastTime = now;
      }

      const dt = pointer.lastTime ? now - pointer.lastTime : 16;
      const dx = e.clientX - pointer.lastX;
      const dy = e.clientY - pointer.lastY;
      let vx = (dx / (dt || 16)) * 1000;
      let vy = (dy / (dt || 16)) * 1000;
      let speed = Math.hypot(vx, vy);

      if (speed > maxSpeed) {
        const scale = maxSpeed / speed;
        vx *= scale;
        vy *= scale;
        speed = maxSpeed;
      }

      pointer.lastTime = now;
      pointer.lastX = e.clientX;
      pointer.lastY = e.clientY;
      pointer.vx = vx;
      pointer.vy = vy;
      pointer.speed = speed;

      pointer.x = e.clientX - rect.left;
      pointer.y = e.clientY - rect.top;

      if (speed > speedTrigger) {
        for (let i = 0; i < dots.length; i++) {
          const dot = dots[i];
          const dist = Math.hypot(dot.cx - pointer.x, dot.cy - pointer.y);
          if (dist < proximity && !dot._inertiaApplied) {
            dot._inertiaApplied = true;
            gsap.killTweensOf(dot);
            const pushX = dot.cx - pointer.x + vx * 0.005;
            const pushY = dot.cy - pointer.y + vy * 0.005;
            gsap.to(dot, {
              inertia: { xOffset: pushX, yOffset: pushY, resistance },
              onComplete: () => {
                gsap.to(dot, {
                  xOffset: 0,
                  yOffset: 0,
                  duration: returnDuration,
                  ease: "elastic.out(1,0.75)",
                });
                dot._inertiaApplied = false;
              },
            });
          }
        }
      }
    };

    const onClick = (e: MouseEvent) => {
      if (isMobile() || !isInteractive || !isVisible) return;

      const rect = canvas.getBoundingClientRect();
      if (
        e.clientX < rect.left - shockRadius ||
        e.clientX > rect.right + shockRadius ||
        e.clientY < rect.top - shockRadius ||
        e.clientY > rect.bottom + shockRadius
      ) {
        return;
      }

      pointer.hasMoved = true;
      const cx = e.clientX - rect.left;
      const cy = e.clientY - rect.top;
      pointer.x = cx;
      pointer.y = cy;
      pointer.lastX = e.clientX;
      pointer.lastY = e.clientY;

      for (let i = 0; i < dots.length; i++) {
        const dot = dots[i];
        const dist = Math.hypot(dot.cx - cx, dot.cy - cy);
        if (dist < shockRadius && !dot._inertiaApplied) {
          dot._inertiaApplied = true;
          gsap.killTweensOf(dot);
          const falloff = Math.max(0, 1 - dist / shockRadius);
          const pushX = (dot.cx - cx) * shockStrength * falloff;
          const pushY = (dot.cy - cy) * shockStrength * falloff;
          gsap.to(dot, {
            inertia: { xOffset: pushX, yOffset: pushY, resistance },
            onComplete: () => {
              gsap.to(dot, {
                xOffset: 0,
                yOffset: 0,
                duration: returnDuration,
                ease: "elastic.out(1,0.75)",
              });
              dot._inertiaApplied = false;
            },
          });
        }
      }
    };

    let touchEndTimeout: ReturnType<typeof setTimeout> | null = null;

    const onTouchMove = (e: TouchEvent) => {
      if (isMobile() || !isInteractive || !isVisible) return;
      if (touchEndTimeout) {
        clearTimeout(touchEndTimeout);
        touchEndTimeout = null;
      }
      if (e.touches && e.touches[0]) {
        onMove(e.touches[0]);
      }
    };

    const onTouchStart = (e: TouchEvent) => {
      if (isMobile() || !isInteractive || !isVisible) return;
      if (touchEndTimeout) {
        clearTimeout(touchEndTimeout);
        touchEndTimeout = null;
      }
      if (e.touches && e.touches[0]) {
        onMove(e.touches[0]);
      }
    };

    const onTouchEnd = () => {
      if (isMobile() || !isInteractive) return;
      touchEndTimeout = setTimeout(() => {
        pointer.x = -1000;
        pointer.y = -1000;
        pointer.lastX = -1000;
        pointer.lastY = -1000;
        pointer.hasMoved = false;
      }, 1000);
    };

    const onMouseLeave = () => {
      pointer.x = -1000;
      pointer.y = -1000;
      pointer.lastX = -1000;
      pointer.lastY = -1000;
      pointer.hasMoved = false;
    };

    const throttledMove = throttle(onMove, 30);
    const throttledTouchMove = throttle(onTouchMove, 30);

    if (isInteractive && !isMobile()) {
      window.addEventListener("mousemove", throttledMove, { passive: true });
      window.addEventListener("touchstart", onTouchStart, { passive: true });
      window.addEventListener("touchmove", throttledTouchMove, { passive: true });
      window.addEventListener("touchend", onTouchEnd, { passive: true });
      document.addEventListener("mouseleave", onMouseLeave);
      window.addEventListener("click", onClick);
    }

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            isVisible = true;
            if (dots.length === 0) {
              buildGrid();
            } else {
              draw();
              if (!isMobile() && isInteractive) {
                cancelAnimationFrame(rafId);
                rafId = requestAnimationFrame(draw);
              }
            }
          } else {
            isVisible = false;
            cancelAnimationFrame(rafId);
          }
        }
      },
      { threshold: 0.01 },
    );
    observer.observe(wrap);

    if (typeof ResizeObserver !== "undefined") {
      const ro = new ResizeObserver((entries) => {
        for (const entry of entries) {
          const { width, height } = entry.contentRect;
          if (width > 0 && height > 0) {
            buildGrid(width, height);
          }
        }
      });
      ro.observe(wrap);
    } else {
      requestAnimationFrame(() => buildGrid());
      window.addEventListener("resize", () => buildGrid(), { passive: true });
    }
  };

  const setupAllDotGrids = () => {
    document
      .querySelectorAll<HTMLElement>("[data-dot-grid]")
      .forEach(initDotGrid);
  };

  onDomReady(setupAllDotGrids);
</script>
