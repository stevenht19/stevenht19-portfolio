---
const { events = [] } = Astro.props;
---

<div class="flex flex-col justify-between pl-8 border-l-2 border-gray-900">
  {
    events.map((event) => (
      <div class="grid lg:grid-cols-2 items-start py-14 md:py-7 relative text-lg md:h-[20rem] lg:h-[14rem]">
        <div>
          <div class="absolute -left-10 mr-1 top-7 lg:top-[3.7rem] w-4 h-4 bg-gray-800 rounded-full border-2 border-gray-800" />
          <div class="rounded-lg shadow-sm">
            <div class="text-sm text-gray-400 mb-1">{event.date}</div>
            <div class="font-semibold text-gray-100 text-xl">{event.title}</div>
            <div class="text-gray-400/80">{event.description}</div>
          </div>
        </div>
        <div class="text-gray-300 text-justify mt-5 max-w-[34.8rem] lg:ml-auto">
          {event.text}
        </div>
      </div>
    ))
  }
</div>
