---
import { Image } from "@astrojs/image/components";
import Github from "../icons/Github.astro";

const { title, description, technologies, path, repo, preview } = Astro.props;
---

<div
  class="flex flex-col p-5 rounded-lg bg-gray-800/10 h-50 hover:bg-gray-900/[0.3] border border-gray-800/70"
>
  <Image
    src={path}
    alt="Snapcify Repo by stevenht19"
    width={700}
    height={400}
    quality={20}
    loading={"lazy"}
    class="pb-5"
    fit="cover"
  />
  <div class="flex flex-1 flex-col justify-start">
    <h2 class="text-white text-lg font-bold my-1">{title}</h2>
    <p class="text-gray-400 max-w-prose text-lg">{description}</p>
  </div>
  <div class="py-5">
    {
      technologies.map((technologie: string) => (
        <span class="text-gray-500 mr-2">{technologie}</span>
      ))
    }
  </div>
  <div class="flex justify-end gap-5">
    {
      preview && (
        <a title={`Go to ${title} Preview`} href={preview}  target="_blank">
          <svg
            viewBox="0 0 24 24"
            viewBox="0 0 24 24"
            width={27}
            height={27}
            class="fill-gray-600 cursor-pointer hover:fill-gray-400"
          >
            <path d="M19 19H5V5h7V3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2v-7h-2v7zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7z" />
          </svg>
        </a>
      )
    }
    {
      repo && (
        <a title={`Go to ${title} Repo`} href={repo} target="_blank">
          <Github size={27} />
        </a>
      )
    }
  </div>
</div>
