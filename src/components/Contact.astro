---
import ContactCard from "./cards/ContactCard.astro";
import Github from "./icons/Github.astro";
import Gmail from "./icons/Gmail.astro";
import Linkedln from "./icons/Linkedln.astro";
import Wsp from "./icons/Wsp.astro";
import Link from "./Link.astro";
---

<section id="contact" class="pt-32">
  <h2 class="text-white font-bold text-4xl pt-10">Contact</h2>
  <p class="text-gray-400 my-6 max-w-prose">
    If you're interested in getting my services or working together, feel free
    to get in touch with me.
  </p>
  <Link path="#" text="Send me an email" />
  <p class="text-gray-400 mt-1 mb-6">mstvdev19@gmail.com</p>
  <Link path="#" text="Text me on Whatsapp" />
  <p class="text-gray-400 mt-1 mb-5">+51981729976</p>
  <p class="text-gray-400 mb-10">or you can find me on this platforms!</p>
  <div class="flex flex-wrap pt-2 pb-5 text-white gap-4">
    <ContactCard title="Linkedln" href="https://www.linkedin.com/in/martin-hernández-torres-4778a3267">
      <Linkedln size={30} />
    </ContactCard>
    <ContactCard title="Github" href="https://github.com/stevenht19">
      <Github size={30} />
    </ContactCard>
    <ContactCard title="Whatsapp" href="https://wa.me/51981729976">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width={30}
        height={30}
        viewBox="0 0 24 24"
        class="text-gray-500 hover:text-gray-400"
        ><!-- Icon from Google Material Icons by Material Design Authors - https://github.com/material-icons/material-icons/blob/master/LICENSE -->
        <path
          fill="currentColor"
          d="M19.05 4.91A9.82 9.82 0 0 0 12.04 2c-5.46 0-9.91 4.45-9.91 9.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21c5.46 0 9.91-4.45 9.91-9.91c0-2.65-1.03-5.14-2.9-7.01m-7.01 15.24c-1.48 0-2.93-.4-4.2-1.15l-.3-.18l-3.12.82l.83-3.04l-.2-.31a8.26 8.26 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24c2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.41 5.83c.02 4.54-3.68 8.23-8.22 8.23m4.52-6.16c-.25-.12-1.47-.72-1.69-.81c-.23-.08-.39-.12-.56.12c-.17.25-.64.81-.78.97c-.14.17-.29.19-.54.06c-.25-.12-1.05-.39-1.99-1.23c-.74-.66-1.23-1.47-1.38-1.72c-.14-.25-.02-.38.11-.51c.11-.11.25-.29.37-.43s.17-.25.25-.41c.08-.17.04-.31-.02-.43s-.56-1.34-.76-1.84c-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31c-.22.25-.86.85-.86 2.07s.89 2.4 1.01 2.56c.12.17 1.75 2.67 4.23 3.74c.59.26 1.05.41 1.41.52c.59.19 1.13.16 1.56.1c.48-.07 1.47-.6 1.67-1.18c.21-.58.21-1.07.14-1.18s-.22-.16-.47-.28"
        ></path></svg
      >
    </ContactCard>
    <ContactCard title="Gmail" href="mailto:mstvdev19@gmail.com">
      <Gmail size={30} />
    </ContactCard>
  </div>
</section>
