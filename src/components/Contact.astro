---
import ContactCard from './ContactCard.astro';
import Github from './icons/Github.astro';
import Gmail from './icons/Gmail.astro';
import Linkedln from './icons/Linkedln.astro';

---

<section id="contact" class="contact">
  <h2 class="text-white font-bold text-4xl pt-10">Contact</h2>
  <p class="text-gray-400 text-lg mt-4 mb-10">I'm on this platforms!</p>
  <div class="flex flex-wrap pt-2 pb-5 text-white gap-4">
    <ContactCard title='Github'>
      <Github size={30} />
    </ContactCard>
    <ContactCard title='Linkedln'>
      <Linkedln size={30} />
    </ContactCard>
    <ContactCard title='Gmail'>
      <Gmail size={30} />
    </ContactCard>
  </div>
</section>
