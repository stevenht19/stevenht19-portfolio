---
import type { AboutExperienceEntry } from "@types";
import ExperienceTechBadge from "./ExperienceTechBadge.astro";

interface Props {
  entry: AboutExperienceEntry;
  class?: string;
}

const { entry, class: className = "" } = Astro.props;
---

<li
  class:list={[
    "experience-row group relative grid gap-6 border-b border-white/8 px-2 py-10 transition-colors duration-500 hover:bg-white/[0.02] sm:px-4 sm:py-12 lg:grid-cols-12 lg:items-start lg:gap-8 lg:px-8",
    className,
  ]}
>
  <span
    class="pointer-events-none absolute inset-x-0 top-0 h-px origin-left scale-x-0 bg-linear-to-r from-primary via-primary/40 to-transparent transition-transform duration-700 ease-out group-hover:scale-x-100"
    aria-hidden="true"
  />

  <div class="lg:col-span-2" data-magnetic-index>
    <span
      class="font-display text-5xl font-extrabold leading-none text-transparent opacity-40 transition-all duration-500 group-hover:translate-x-2 group-hover:opacity-90 [-webkit-text-stroke:1px_rgba(212,255,0,0.5)] sm:text-6xl lg:text-7xl"
      aria-hidden="true"
    >
      {entry.index}
    </span>
  </div>

  <div class="lg:col-span-7">
    <h3
      class="font-display text-2xl font-extrabold leading-tight tracking-tight text-white transition-colors duration-500 group-hover:text-primary sm:text-3xl"
    >
      {entry.role}
    </h3>
    <p class="mt-2 text-sm font-medium text-zinc-400 sm:text-base">
      {entry.company}
      <span class="text-zinc-600"> — {entry.location}</span>
    </p>

    <ul class="mt-5 flex flex-wrap items-center gap-2">
      {entry.stack.map((tech) => (
        <ExperienceTechBadge tech={tech} />
      ))}
    </ul>
  </div>

  <div class="lg:col-span-3 lg:text-right">
    <p
      class="inline-flex items-center gap-3 font-display text-sm font-medium tracking-tight text-zinc-400 after:h-px after:w-6 after:bg-primary/40 after:content-[''] lg:after:order-first"
    >
      {entry.timeframe}
    </p>
  </div>
</li>
