---
import type { SocialLink } from "@types";
import { DEFAULT_SOCIAL_LINKS } from "@data/site";
import Icon from "@components/ui/Icon.astro";
import { CONTACT_BRAND_STYLES } from "./contactStyles";

interface Props {
  socials?: SocialLink[];
  class?: string;
}

const { socials = DEFAULT_SOCIAL_LINKS, class: className = "" } = Astro.props;
---

<div
  class:list={[
    "contact-socials mt-7 flex flex-wrap items-center justify-center gap-3",
    className,
  ]}
>
  {
    socials.map((item) => {
      const key = item.name.toLowerCase();
      const brand = CONTACT_BRAND_STYLES[key] ?? {
        iconState: "group-hover:bg-white group-hover:text-zinc-950",
        shadowHover:
          "group-hover:shadow-[0_10px_30px_-8px_rgba(255,255,255,0.4)]",
      };

      return (
        <a
          href={item.href}
          target="_blank"
          rel="noopener noreferrer"
          class:list={[
            "group inline-flex items-center gap-3 rounded-full border border-white/10 bg-white/3 py-1.5 pl-1.5 pr-5 backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 hover:border-white/25 hover:bg-white/6",
            brand.shadowHover,
            "focus:outline-none focus-visible:ring-2 focus-visible:ring-primary",
          ]}
          aria-label={item.ariaLabel}
          title={item.title}
        >
          <span
            class:list={[
              "grid h-9 w-9 place-items-center rounded-full bg-white/5 text-zinc-300 transition-all duration-300",
              brand.iconState,
            ]}
            aria-hidden="true"
          >
            <Icon name={key as any} class="h-4 w-4 fill-current" />
          </span>
          <span class="text-sm font-semibold text-zinc-300 transition-colors duration-300 group-hover:text-white">
            {item.name}
          </span>
          <svg
            class="h-3.5 w-3.5 text-zinc-600 transition-all duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-primary"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M7 17L17 7" />
            <path d="M7 7h10v10" />
          </svg>
        </a>
      );
    })
  }
</div>
