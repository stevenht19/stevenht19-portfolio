---
interface Props {
  titleStart?: string;
  titleHighlight?: string;
  description?: string;
  class?: string;
}

const {
  titleStart = "Impulsa tu negocio con",
  titleHighlight = "software de alto nivel",
  description = "Cuéntame los retos de tu operación. Te ayudo a planificar, desarrollar y desplegar la solución tecnológica adecuada.",
  class: className = "",
} = Astro.props;
---

<header class:list={["contact-header", className]}>
  <h2
    class="contact-heading mt-8 font-display font-extrabold leading-[0.95] tracking-tight text-white text-[clamp(2.75rem,5.2vw+0.75rem,5.6rem)]"
  >
    <span class="block">{titleStart}</span>
    <span class="shiny-text block">{titleHighlight}</span>
  </h2>

  <p
    class="contact-sub mx-auto mt-8 max-w-2xl text-base leading-relaxed text-zinc-400 sm:text-lg"
  >
    {description}
  </p>
</header>

<style>
  .shiny-text {
    background-image: linear-gradient(
      115deg,
      #d4ff00 0%,
      #faffd6 25%,
      #d4ff00 50%,
      #faffd6 75%,
      #d4ff00 100%
    );
    background-size: 200% 100%;
    color: transparent;
    -webkit-background-clip: text;
    background-clip: text;
    animation: shine 3.5s linear infinite;
  }

  @keyframes shine {
    0% {
      background-position: 0% center;
    }
    100% {
      background-position: -200% center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .shiny-text {
      animation: none;
      background: none;
      color: var(--color-primary);
    }
  }
</style>
