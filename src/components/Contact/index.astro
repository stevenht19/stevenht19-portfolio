---
import ContactHeader from "./ContactHeader.astro";
import ContactActions from "./ContactActions.astro";
import ContactSocials from "./ContactSocials.astro";
import DotGrid from "../ui/DotGrid.astro";

interface Props {
  class?: string;
  titleStart?: string;
  titleHighlight?: string;
  description?: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  class: className = "",
  titleStart,
  titleHighlight,
  description,
  ctaLabel,
  ctaHref,
} = Astro.props;
---

<section
  id="contacto"
  aria-label="Contacto"
  class:list={[
    "relative overflow-hidden border-t border-white/8 bg-[#07080c] py-18 lg:py-36",
    className,
  ]}
>
  <DotGrid />
  <div
    class="relative mx-auto max-w-5xl px-6 text-center sm:px-10 2xl:max-w-368 2xl:px-12 3xl:max-w-[114rem] 3xl:px-16"
  >
    <slot name="header">
      <ContactHeader
        titleStart={titleStart}
        titleHighlight={titleHighlight}
        description={description}
      />
    </slot>

    <slot name="actions">
      <ContactActions label={ctaLabel} href={ctaHref} />
    </slot>

    <slot name="socials">
      <ContactSocials />
    </slot>
  </div>
</section>

<script>
  import { gsap, prefersReducedMotion, onDomReady } from "@utils/motion";

  function initContactAnimations() {
    const targets = gsap.utils.toArray<HTMLElement>([
      ".contact-heading",
      ".contact-sub",
      ".contact-cta",
      ".contact-socials",
    ]);

    if (!prefersReducedMotion()) {
      gsap.fromTo(
        targets,
        { opacity: 0, y: 30 },
        {
          opacity: 1,
          y: 0,
          duration: 0.8,
          ease: "power3.out",
          stagger: 0.1,
          scrollTrigger: {
            trigger: "#contacto",
            start: "top 75%",
            once: true,
          },
        },
      );
    } else {
      gsap.set(targets, { opacity: 1, y: 0 });
    }
  }

  onDomReady(initContactAnimations);
</script>
