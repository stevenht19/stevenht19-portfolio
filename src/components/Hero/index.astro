---
import HeroBackground from "./HeroBackground.astro";
import HeroPortraitCard from "./HeroPortraitCard.astro";
import HeroTypography from "./HeroTypography.astro";
import HeroActions from "./HeroActions.astro";

interface Props {
  class?: string;
  greeting?: string;
  name?: string;
  primaryHref?: string;
  primaryLabel?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
  portraitAlt?: string;
}

const {
  class: className = "",
  greeting,
  name,
  primaryHref,
  primaryLabel,
  secondaryHref,
  secondaryLabel,
  portraitAlt,
} = Astro.props;
---

<section
  class:list={[
    "hero-section relative flex flex-col justify-between w-full overflow-hidden lg:min-h-[calc(60dvh-4rem)] lg:h-[calc(60dvh-4rem)]",
    className,
  ]}
  aria-label="Presentación principal"
>
  <slot name="background">
    <HeroBackground />
  </slot>
  <div
    class="relative z-10 max-w-7xl w-full mx-auto flex-1 flex flex-col lg:flex-row items-center lg:items-end justify-between px-6 sm:px-9 pt-18 lg:pt-0 gap-6 lg:gap-8 min-h-0"
  >
    <div class="z-20 w-full lg:self-center py-2 sm:py-4 lg:py-0">
      <slot name="typography">
        <HeroTypography greeting={greeting} name={name} />
      </slot>
      <slot name="actions">
        <HeroActions
          primaryHref={primaryHref}
          primaryLabel={primaryLabel}
          secondaryHref={secondaryHref}
          secondaryLabel={secondaryLabel}
        />
      </slot>
    </div>
    <div
      class="w-full lg:w-auto flex justify-center lg:justify-end items-end z-20 mt-auto min-h-0 h-full max-h-[46vh] sm:max-h-[50vh] lg:max-h-[calc(100dvh-7rem)]"
    >
      <slot name="portrait">
        <HeroPortraitCard alt={portraitAlt} />
      </slot>
    </div>
  </div>
  <div class="absolute bottom-0 inset-x-0 h-px bg-white/[0.06] z-20"></div>
</section>
