---
import { SITE_INFO } from "@data/site";
import HeroBackground from "./HeroBackground.astro";
import HeroPortraitCard from "./HeroPortraitCard.astro";
import HeroTypography from "./HeroTypography.astro";
import HeroActions from "./HeroActions.astro";

interface Props {
  class?: string;
  greeting?: string;
  name?: string;
  primaryHref?: string;
  primaryLabel?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
  portraitAlt?: string;
}

const {
  class: className = "",
  greeting,
  name,
  primaryHref = SITE_INFO.whatsapp,
  primaryLabel,
  secondaryHref,
  secondaryLabel,
  portraitAlt,
} = Astro.props;
---

<section
  class:list={[
    "hero-section relative flex flex-col justify-center w-full overflow-hidden pt-17 lg:pt-0 lg:min-h-[calc(100dvh-5.2rem)] 3xl:min-h-205 3xl:py-24",
    className,
  ]}
  aria-label="Presentación principal"
>
  <slot name="background">
    <HeroBackground />
  </slot>

  <div
    class="relative z-10 max-w-7xl 2xl:max-w-368 3xl:max-w-[114rem] w-full mx-auto px-6 sm:px-9 2xl:px-12 3xl:px-16 flex flex-col lg:flex-row items-start lg:items-center justify-between gap-10 md:gap-8 lg:gap-14 2xl:gap-16 3xl:gap-20"
  >
    <div
      class="z-20 w-full md:flex-1 max-w-2xl 2xl:max-w-3xl space-y-8 sm:space-y-10 text-left"
    >
      <slot name="typography">
        <HeroTypography greeting={greeting} name={name} />
      </slot>
      <slot name="actions">
        <HeroActions
          primaryHref={primaryHref}
          primaryLabel={primaryLabel}
          secondaryHref={secondaryHref}
          secondaryLabel={secondaryLabel}
        />
      </slot>
    </div>

    <div class="w-auto z-20 mx-auto">
      <slot name="portrait">
        <HeroPortraitCard alt={portraitAlt} />
      </slot>
    </div>
  </div>

  <div
    class="absolute bottom-0 inset-x-0 h-px bg-linear-to-r from-transparent via-white/10 to-transparent z-20 pointer-events-none"
  >
  </div>
</section>
