---
import FibonacciBackground from "../FibonacciBackground";
import DotGrid from "../DotGrid";

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<div class:list={["absolute inset-0 z-0 overflow-hidden", className]}>
  <FibonacciBackground client:only="preact" />
  <div class="absolute inset-0 z-1">
    <DotGrid
      client:only="preact"
      gap={24}
      dotSize={2.5}
      baseColor="#232426"
      activeColor="#bfdbfe"
      proximity={180}
      speedTrigger={80}
      shockRadius={220}
      shockStrength={4}
      maxSpeed={4000}
      resistance={800}
      returnDuration={1.8}
    />
  </div>
</div>
