---
import { SITE_INFO } from "@data/site";
import Icon from "@components/ui/Icon.astro";
import Button from "@components/ui/Button.astro";
import CtaIcon from "@components/ui/CtaIcon.astro";

interface Props {
  primaryHref?: string;
  primaryLabel?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
  class?: string;
}

const {
  primaryHref = SITE_INFO.whatsapp,
  primaryLabel = "Hablemos de tu idea",
  secondaryHref = "#proyectos",
  secondaryLabel = "Explorar proyectos",
  class: className = "",
} = Astro.props;
---

<div
  class:list={[
    "hero-actions-root flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 sm:gap-4 select-none opacity-0 will-change-transform",
    className,
  ]}
>
  <div class="flex items-center gap-3 flex-wrap">
    <Button
      href={primaryHref}
      variant="primary"
      size="md"
      class="gap-3 shadow-[0_0_36px_-6px_rgba(212,255,0,0.48)] hover:shadow-[0_0_54px_-4px_rgba(212,255,0,0.75)]"
    >
      <span>{primaryLabel}</span>
      <CtaIcon />
    </Button>

    <Button
      href={secondaryHref}
      variant="secondary"
      size="md"
      class="hero-btn-secondary gap-2.5 focus-visible:ring-purple-400/40"
    >
      <span class="tracking-tight text-[14px] font-medium"
        >{secondaryLabel}</span
      >
      <span
        class="flex h-5 w-5 items-center justify-center rounded-full bg-white/6 text-zinc-400 group-hover:text-white group-hover:bg-white/12 transition-colors duration-300"
        aria-hidden="true"
      >
        <Icon
          name="arrow-down"
          class="w-3 h-3 transition-transform duration-300 group-hover:translate-y-0.5"
        />
      </span>
    </Button>
  </div>

  <div class="flex items-center gap-2 pt-1 sm:pt-0">
    <span class="hidden sm:block h-6 w-px bg-white/10 mx-1" aria-hidden="true"
    ></span>

    <div class="flex items-center gap-1.5">
      <a
        href={SITE_INFO.socials.github.href}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center w-9 h-9 rounded-full border border-white/10 bg-white/2.5 text-zinc-400 hover:text-white hover:bg-white/8 hover:border-white/20 transition-all duration-200 hover:-translate-y-0.5 active:scale-95 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary"
        aria-label={SITE_INFO.socials.github.ariaLabel}
        title={SITE_INFO.socials.github.title}
      >
        <Icon name="github" class="w-4 h-4 fill-current" />
      </a>

      <a
        href={SITE_INFO.socials.linkedin.href}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center w-9 h-9 rounded-full border border-white/10 bg-white/2.5 text-zinc-400 hover:text-white hover:bg-white/8 hover:border-white/20 transition-all duration-200 hover:-translate-y-0.5 active:scale-95 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary"
        aria-label={SITE_INFO.socials.linkedin.ariaLabel}
        title={SITE_INFO.socials.linkedin.title}
      >
        <Icon name="linkedin" class="w-4 h-4 fill-current" />
      </a>
    </div>
  </div>

  <slot />
</div>

<script>
  import { gsap, prefersReducedMotion, onDomReady } from "@utils/motion";

  function initHeroActions() {
    const root = document.querySelector(
      ".hero-actions-root",
    ) as HTMLElement | null;

    if (!root) return;

    if (!prefersReducedMotion()) {
      gsap.fromTo(
        root,
        {
          opacity: 0,
          y: 22,
          scale: 0.98,
        },
        {
          opacity: 1,
          y: 0,
          scale: 1,
          duration: 0.65,
          delay: 0.55,
          ease: "power3.out",
        },
      );
    } else {
      gsap.set(root, { opacity: 1, y: 0, scale: 1 });
    }
  }

  onDomReady(initHeroActions);
</script>
