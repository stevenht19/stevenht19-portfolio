---
import { SITE_INFO } from "@data/site";
import Icon from "@components/ui/Icon.astro";

interface Props {
  primaryHref?: string;
  primaryLabel?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
  class?: string;
}

const {
  primaryHref = "#contacto",
  primaryLabel = "Hablemos de tu idea",
  secondaryHref = "#proyectos",
  secondaryLabel = "Explorar proyectos",
  class: className = "",
} = Astro.props;
---

<div
  class:list={[
    "hero-actions-root flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 sm:gap-4 select-none opacity-0 will-change-transform",
    className,
  ]}
>
  <div class="flex items-center gap-3 flex-wrap">
    <a
      href={primaryHref}
      class="relative inline-flex items-center justify-center gap-3 rounded-full bg-primary px-6 py-3 sm:py-3.5 text-sm font-medium text-zinc-950 shadow-[0_0_36px_-6px_rgba(212,255,0,0.48)] hover:bg-primary-hover hover:shadow-[0_0_54px_-4px_rgba(212,255,0,0.75)] transition-all duration-300 hover:-translate-y-0.5 active:translate-y-0 active:scale-[0.97] overflow-hidden focus:outline-none focus-visible:ring-2 focus-visible:ring-primary"
    >
      <span>{primaryLabel}</span>
      <span
        class="relative z-10 flex h-6 w-6 items-center justify-center rounded-full bg-zinc-950 text-white shadow-[0_2px_10px_rgba(0,0,0,0.4)] transition-all duration-300 group-hover:scale-110"
        aria-hidden="true"
      >
        <span
          class="text-xs font-bold leading-none transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
          aria-hidden="true"
        >
          ↗
        </span>
      </span>
    </a>

    <a
      href={secondaryHref}
      class="hero-btn-secondary group relative inline-flex items-center justify-center gap-2.5 rounded-full border border-white/12 bg-white/3.5 hover:bg-purple-500/10 hover:border-purple-400/35 px-5 py-3 sm:py-3.5 text-sm font-medium text-zinc-300 hover:text-white backdrop-blur-xl transition-all duration-300 hover:-translate-y-0.5 active:translate-y-0 active:scale-[0.97] focus:outline-none focus-visible:ring-2 focus-visible:ring-purple-400/40"
    >
      <span class="tracking-tight text-[14px] font-medium"
        >{secondaryLabel}</span
      >
      <span
        class="flex h-5 w-5 items-center justify-center rounded-full bg-white/6 text-zinc-400 group-hover:text-white group-hover:bg-white/12 transition-colors duration-300"
        aria-hidden="true"
      >
        <Icon
          name="arrow-down"
          class="w-3 h-3 transition-transform duration-300 group-hover:translate-y-0.5"
        />
      </span>
    </a>
  </div>

  <div class="flex items-center gap-2 pt-1 sm:pt-0">
    <span class="hidden sm:block h-6 w-px bg-white/10 mx-1" aria-hidden="true"
    ></span>

    <div class="flex items-center gap-1.5">
      <a
        href={SITE_INFO.socials.github.href}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center w-9 h-9 rounded-full border border-white/10 bg-white/2.5 text-zinc-400 hover:text-white hover:bg-white/8 hover:border-white/20 transition-all duration-200 hover:-translate-y-0.5 active:scale-95 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary"
        aria-label={SITE_INFO.socials.github.ariaLabel}
        title={SITE_INFO.socials.github.title}
      >
        <Icon name="github" class="w-4 h-4 fill-current" />
      </a>

      <a
        href={SITE_INFO.socials.linkedin.href}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center w-9 h-9 rounded-full border border-white/10 bg-white/2.5 text-zinc-400 hover:text-white hover:bg-white/8 hover:border-white/20 transition-all duration-200 hover:-translate-y-0.5 active:scale-95 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary"
        aria-label={SITE_INFO.socials.linkedin.ariaLabel}
        title={SITE_INFO.socials.linkedin.title}
      >
        <Icon name="linkedin" class="w-4 h-4 fill-current" />
      </a>
    </div>
  </div>

  <slot />
</div>

<script>
  import { gsap } from "gsap";

  const root = document.querySelector(
    ".hero-actions-root",
  ) as HTMLElement | null;

  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  if (root) {
    if (!prefersReducedMotion) {
      gsap.fromTo(
        root,
        {
          opacity: 0,
          y: 22,
          scale: 0.98,
        },
        {
          opacity: 1,
          y: 0,
          scale: 1,
          duration: 0.65,
          delay: 0.55,
          ease: "power3.out",
        },
      );
    } else {
      gsap.set(root, { opacity: 1, y: 0, scale: 1 });
    }
  }
</script>
