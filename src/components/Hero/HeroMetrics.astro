---
import { METRICS_DATA } from "@data/metrics";

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<section
  class:list={[
    "hero-metrics-section relative w-full border-b border-white/8 bg-zinc-950",
    className,
  ]}
  aria-label="Métricas de trayectoria y experiencia"
>
  <div
    class="max-w-7xl 2xl:max-w-368 3xl:max-w-[114rem] mx-auto px-6 sm:px-9 2xl:px-12 3xl:px-16 py-8 sm:py-14 2xl:py-16"
  >
    <div class="grid grid-cols-2 lg:grid-cols-4">
      {
        METRICS_DATA.map((item, index) => {
          const mobileColBorder =
            index % 2 === 1
              ? "border-l border-white/8 pl-4 sm:pl-7"
              : "pr-4 sm:pr-7";
          const mobileRowBorder =
            index >= 2
              ? "border-t border-white/8 pt-6 sm:pt-8"
              : "pb-6 sm:pb-8";
          const desktopClasses =
            "lg:border-t-0 lg:border-l lg:border-white/8 lg:py-8 lg:px-8 2xl:px-10 lg:first:pl-0 lg:last:pr-0 lg:first:border-l-0";

          return (
            <div
              class:list={[
                "hero-metric-item group relative flex flex-col justify-between opacity-0 will-change-transform select-none transition-colors duration-300",
                mobileColBorder,
                mobileRowBorder,
                desktopClasses,
              ]}
            >
              <div class="flex flex-col gap-2.5 sm:gap-3">
                <span class="text-[11px] sm:text-xs font-semibold uppercase tracking-[0.2em] text-zinc-500 transition-colors duration-300 group-hover:text-zinc-400">
                  {item.index} · {item.category}
                </span>

                {item.type === "stat" && (
                  <div class="flex flex-wrap items-baseline gap-x-2 gap-y-0.5 sm:gap-2.5">
                    <span
                      class:list={[
                        "hero-metric-stat font-display font-extrabold tracking-tight text-white transition-colors duration-300 group-hover:text-primary leading-tight",
                        /^\+?\d+$/.test(item.statValue ?? "")
                          ? "text-3xl sm:text-4xl lg:text-5xl leading-none"
                          : "text-xl sm:text-2xl lg:text-3xl",
                      ]}
                    >
                      {item.statValue}
                    </span>
                    {item.statSuffix && (
                      <span class="text-sm sm:text-base lg:text-lg font-semibold text-zinc-400">
                        {item.statSuffix}
                      </span>
                    )}
                  </div>
                )}

                {(item.type === "list" || item.type === "location") && (
                  <span class="font-display text-xl sm:text-2xl lg:text-3xl font-extrabold tracking-tight text-white transition-colors duration-300 group-hover:text-primary leading-tight">
                    {item.type === "location"
                      ? item.title
                      : item.items?.map((tech, i) => (
                          <span>
                            {tech}
                            {i < (item.items?.length ?? 0) - 1 && (
                              <span class="text-zinc-600 font-normal"> · </span>
                            )}
                          </span>
                        ))}
                  </span>
                )}

                <p class="mt-1 text-xs sm:text-sm font-medium leading-relaxed text-zinc-400 sm:text-zinc-400 transition-colors duration-300 group-hover:text-zinc-300">
                  {item.label}
                </p>
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</section>

<script>
  import { gsap, prefersReducedMotion, onDomReady } from "@utils/motion";

  function initHeroMetrics() {
    const isReduced = prefersReducedMotion();
    const metricItems = document.querySelectorAll(".hero-metric-item");
    const section = document.querySelector(".hero-metrics-section");

    if (!isReduced) {
      if (metricItems.length > 0) {
        gsap.fromTo(
          metricItems,
          { opacity: 0, y: 34, filter: "blur(4px)" },
          {
            opacity: 1,
            y: 0,
            filter: "blur(0px)",
            duration: 0.75,
            ease: "power3.out",
            stagger: 0.12,
            scrollTrigger: {
              trigger: section,
              start: "top 84%",
              once: true,
            },
          },
        );
      }

      metricItems.forEach((item) => {
        item.addEventListener(
          "mouseenter",
          () => {
            gsap.to(item, { y: -4, duration: 0.25, ease: "power2.out" });
          },
          { passive: true },
        );
        item.addEventListener(
          "mouseleave",
          () => {
            gsap.to(item, { y: 0, duration: 0.35, ease: "power2.out" });
          },
          { passive: true },
        );
      });
    } else {
      gsap.set(Array.from(metricItems), {
        opacity: 1,
        y: 0,
        filter: "blur(0px)",
      });
    }
  }

  onDomReady(initHeroMetrics);
</script>
