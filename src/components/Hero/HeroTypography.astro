---
import { SITE_INFO } from "@data/site";

interface Props {
  greeting?: string;
  name?: string;
  class?: string;
}

const {
  greeting = "Hola, soy",
  name = SITE_INFO.name,
  class: className = "",
} = Astro.props;

const parts = name.trim().split(/\s+/);
const firstName = parts.length > 1 ? parts.slice(0, -1).join(" ") : parts[0];
const lastName = parts.length > 1 ? parts[parts.length - 1] : "";
---

<div
  class:list={["hero-typography-container space-y-4 select-none", className]}
>
  <div class="tracking-tight leading-[1.02]">
    <div
      class="text-xl sm:text-2xl lg:text-3xl font-display font-medium text-zinc-400 mb-1 sm:mb-2"
      aria-label={greeting}
    >
      <span class="inline-block" aria-hidden="true">
        {
          greeting
            .split("")
            .map((char) => (
              <span class="hero-greeting-char inline-block will-change-transform opacity-0">
                {char === " " ? "\u00A0" : char}
              </span>
            ))
        }
      </span>
    </div>

    <div class="relative inline-block max-w-4xl w-full">
      <h1
        class="text-[clamp(2.75rem,5.2vw+0.75rem,5.6rem)] font-display font-extrabold text-white leading-[0.95] tracking-tight"
        aria-label={name}
      >
        <span class="inline-block whitespace-nowrap" aria-hidden="true">
          {
            firstName
              .split("")
              .map((char) => (
                <span class="hero-name-char inline-block will-change-transform opacity-0 [text-shadow:0_0_90px_rgba(168,85,247,0.32)]">
                  {char === " " ? "\u00A0" : char}
                </span>
              ))
          }
        </span>{" "}
        <span
          class="relative inline-block whitespace-nowrap"
          aria-hidden="true"
        >
          {
            lastName
              .split("")
              .map((char) => (
                <span class="hero-name-char inline-block text-transparent [-webkit-text-stroke:1px_var(--color-primary)] sm:[-webkit-text-stroke:1.8px_var(--color-primary)] will-change-transform opacity-0">
                  {char === " " ? "\u00A0" : char}
                </span>
              ))
          }
        </span>
      </h1>
    </div>
  </div>

  <p
    class="hero-bio text-zinc-300/90 text-base sm:text-lg max-w-xl leading-relaxed font-normal opacity-0 will-change-transform"
  >
    <span class="text-primary font-semibold">{SITE_INFO.role}</span>{" "}
    {SITE_INFO.bio}
  </p>
</div>

<script>
  import { gsap } from "gsap";

  const greetingChars = document.querySelectorAll(".hero-greeting-char");
  const nameChars = document.querySelectorAll(".hero-name-char");
  const bio = document.querySelector(".hero-bio");

  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  if (!prefersReducedMotion) {
    const tl = gsap.timeline({
      delay: 0.1,
      onComplete: () => {
        if (nameChars.length > 0) {
          gsap.to(nameChars, {
            y: -7,
            duration: 1.5,
            ease: "sine.inOut",
            stagger: {
              each: 0.08,
              repeat: -1,
              yoyo: true,
            },
          });
        }
      },
    });

    if (greetingChars.length > 0) {
      tl.fromTo(
        greetingChars,
        {
          opacity: 0,
          y: 18,
          filter: "blur(4px)",
        },
        {
          opacity: 1,
          y: 0,
          filter: "blur(0px)",
          duration: 0.45,
          stagger: 0.025,
          ease: "power3.out",
        },
      );
    }

    if (nameChars.length > 0) {
      tl.fromTo(
        nameChars,
        {
          opacity: 0,
          y: 26,
          filter: "blur(6px)",
        },
        {
          opacity: 1,
          y: 0,
          filter: "blur(0px)",
          duration: 0.6,
          stagger: 0.03,
          ease: "power3.out",
        },
        "-=0.25",
      );
    }

    if (bio) {
      tl.fromTo(
        bio,
        {
          opacity: 0,
          y: 16,
        },
        {
          opacity: 1,
          y: 0,
          duration: 0.55,
          ease: "power3.out",
        },
        "-=0.25",
      );
    }
  } else {
    gsap.set([...greetingChars, ...nameChars, bio].filter(Boolean), {
      opacity: 1,
      y: 0,
      scaleX: 1,
      scale: 1,
      filter: "blur(0px)",
    });
  }
</script>
