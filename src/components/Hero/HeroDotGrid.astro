---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<div
  class:list={[
    "relative flex items-center justify-center w-full h-full",
    className,
  ]}
>
  <div id="hero-dot-grid-wrap" class="relative w-full h-full">
    <canvas
      id="hero-dot-grid-canvas"
      class="absolute inset-0 w-full h-full pointer-events-none"></canvas>
  </div>
</div>

<script>
  import { gsap } from "gsap";
  import { InertiaPlugin } from "gsap/InertiaPlugin";

  gsap.registerPlugin(InertiaPlugin);

  interface Dot {
    cx: number;
    cy: number;
    xOffset: number;
    yOffset: number;
    _inertiaApplied: boolean;
  }

  const dotSize = 2.5;
  const gap = 24;
  const baseColor = "#232426";
  const activeColor = "#d4ff00";
  const proximity = 180;
  const speedTrigger = 80;
  const shockRadius = 220;
  const shockStrength = 4;
  const maxSpeed = 4000;
  const resistance = 800;
  const returnDuration = 1.8;

  function hexToRgb(hex: string) {
    const m = hex.match(/^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i);
    if (!m) return { r: 0, g: 0, b: 0 };
    return {
      r: parseInt(m[1], 16),
      g: parseInt(m[2], 16),
      b: parseInt(m[3], 16),
    };
  }

  function throttle<T extends (...args: any[]) => void>(
    func: T,
    limit: number,
  ) {
    let lastCall = 0;
    return function (...args: Parameters<T>) {
      const now = performance.now();
      if (now - lastCall >= limit) {
        lastCall = now;
        func(...args);
      }
    };
  }

  const wrap = document.getElementById("hero-dot-grid-wrap");
  const canvas = document.getElementById(
    "hero-dot-grid-canvas",
  ) as HTMLCanvasElement | null;

  if (wrap && canvas) {
    let dots: Dot[] = [];
    const pointer = {
      x: -1000,
      y: -1000,
      vx: 0,
      vy: 0,
      speed: 0,
      lastTime: 0,
      lastX: -1000,
      lastY: -1000,
      hasMoved: false,
    };

    const baseRgb = hexToRgb(baseColor);
    const activeRgb = hexToRgb(activeColor);
    const proxSq = proximity * proximity;

    const circlePath =
      typeof window !== "undefined" && window.Path2D ? new Path2D() : null;
    if (circlePath) {
      circlePath.arc(0, 0, dotSize / 2, 0, Math.PI * 2);
    }

    const isMobile = () => {
      if (typeof window === "undefined") return false;
      return (
        window.innerWidth < 768 ||
        window.matchMedia("(max-width: 768px)").matches ||
        window.matchMedia("(hover: none)").matches
      );
    };

    const buildGrid = () => {
      const { width, height } = wrap.getBoundingClientRect();
      const dpr = window.devicePixelRatio || 1;

      canvas.width = width * dpr;
      canvas.height = height * dpr;
      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;
      const ctx = canvas.getContext("2d");
      if (ctx) ctx.scale(dpr, dpr);

      const cols = Math.floor((width + gap) / (dotSize + gap));
      const rows = Math.floor((height + gap) / (dotSize + gap));
      const cell = dotSize + gap;

      const gridW = cell * cols - gap;
      const gridH = cell * rows - gap;

      const extraX = width - gridW;
      const extraY = height - gridH;

      const startX = extraX / 2 + dotSize / 2;
      const startY = extraY / 2 + dotSize / 2;

      const newDots: Dot[] = [];
      for (let y = 0; y < rows; y++) {
        for (let x = 0; x < cols; x++) {
          const cx = startX + x * cell;
          const cy = startY + y * cell;
          newDots.push({
            cx,
            cy,
            xOffset: 0,
            yOffset: 0,
            _inertiaApplied: false,
          });
        }
      }
      dots = newDots;

      cancelAnimationFrame(rafId);
      if (isMobile()) {
        for (let i = 0; i < dots.length; i++) {
          gsap.killTweensOf(dots[i]);
          dots[i].xOffset = 0;
          dots[i].yOffset = 0;
          dots[i]._inertiaApplied = false;
        }
        pointer.x = -1000;
        pointer.y = -1000;
        pointer.hasMoved = false;
        draw();
      } else if (isVisible) {
        rafId = requestAnimationFrame(draw);
      }
    };

    let rafId = 0;
    let isVisible = true;

    const draw = () => {
      if (!canvas || !isVisible) return;
      const ctx = canvas.getContext("2d");
      if (!ctx) return;
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      const mobile = isMobile();
      const px = mobile ? -1000 : pointer.x;
      const py = mobile ? -1000 : pointer.y;

      for (let i = 0; i < dots.length; i++) {
        const dot = dots[i];
        const ox = dot.cx + dot.xOffset;
        const oy = dot.cy + dot.yOffset;
        const dx = dot.cx - px;
        const dy = dot.cy - py;
        const dsq = dx * dx + dy * dy;

        let fillStyle = baseColor;
        if (!mobile && dsq <= proxSq) {
          const dist = Math.sqrt(dsq);
          const t = 1 - dist / proximity;
          const r = Math.round(baseRgb.r + (activeRgb.r - baseRgb.r) * t);
          const g = Math.round(baseRgb.g + (activeRgb.g - baseRgb.g) * t);
          const b = Math.round(baseRgb.b + (activeRgb.b - baseRgb.b) * t);
          fillStyle = `rgb(${r},${g},${b})`;
        }

        ctx.save();
        ctx.translate(ox, oy);
        ctx.fillStyle = fillStyle;
        if (circlePath) {
          ctx.fill(circlePath);
        } else {
          ctx.beginPath();
          ctx.arc(0, 0, dotSize / 2, 0, Math.PI * 2);
          ctx.fill();
        }
        ctx.restore();
      }

      if (!mobile) {
        rafId = requestAnimationFrame(draw);
      }
    };

    const onMove = (e: MouseEvent | Touch) => {
      if (isMobile()) return;
      const now = performance.now();
      if (!pointer.hasMoved) {
        pointer.hasMoved = true;
        pointer.lastX = e.clientX;
        pointer.lastY = e.clientY;
        pointer.lastTime = now;
      }
      const dt = pointer.lastTime ? now - pointer.lastTime : 16;
      const dx = e.clientX - pointer.lastX;
      const dy = e.clientY - pointer.lastY;
      let vx = (dx / dt) * 1000;
      let vy = (dy / dt) * 1000;
      let speed = Math.hypot(vx, vy);
      if (speed > maxSpeed) {
        const scale = maxSpeed / speed;
        vx *= scale;
        vy *= scale;
        speed = maxSpeed;
      }
      pointer.lastTime = now;
      pointer.lastX = e.clientX;
      pointer.lastY = e.clientY;
      pointer.vx = vx;
      pointer.vy = vy;
      pointer.speed = speed;

      const rect = canvas.getBoundingClientRect();
      pointer.x = e.clientX - rect.left;
      pointer.y = e.clientY - rect.top;

      for (let i = 0; i < dots.length; i++) {
        const dot = dots[i];
        const dist = Math.hypot(dot.cx - pointer.x, dot.cy - pointer.y);
        if (speed > speedTrigger && dist < proximity && !dot._inertiaApplied) {
          dot._inertiaApplied = true;
          gsap.killTweensOf(dot);
          const pushX = dot.cx - pointer.x + vx * 0.005;
          const pushY = dot.cy - pointer.y + vy * 0.005;
          gsap.to(dot, {
            inertia: { xOffset: pushX, yOffset: pushY, resistance },
            onComplete: () => {
              gsap.to(dot, {
                xOffset: 0,
                yOffset: 0,
                duration: returnDuration,
                ease: "elastic.out(1,0.75)",
              });
              dot._inertiaApplied = false;
            },
          });
        }
      }
    };

    const onClick = (e: MouseEvent) => {
      if (isMobile()) return;
      pointer.hasMoved = true;
      const rect = canvas.getBoundingClientRect();
      const cx = e.clientX - rect.left;
      const cy = e.clientY - rect.top;
      pointer.x = cx;
      pointer.y = cy;
      pointer.lastX = e.clientX;
      pointer.lastY = e.clientY;

      for (let i = 0; i < dots.length; i++) {
        const dot = dots[i];
        const dist = Math.hypot(dot.cx - cx, dot.cy - cy);
        if (dist < shockRadius && !dot._inertiaApplied) {
          dot._inertiaApplied = true;
          gsap.killTweensOf(dot);
          const falloff = Math.max(0, 1 - dist / shockRadius);
          const pushX = (dot.cx - cx) * shockStrength * falloff;
          const pushY = (dot.cy - cy) * shockStrength * falloff;
          gsap.to(dot, {
            inertia: { xOffset: pushX, yOffset: pushY, resistance },
            onComplete: () => {
              gsap.to(dot, {
                xOffset: 0,
                yOffset: 0,
                duration: returnDuration,
                ease: "elastic.out(1,0.75)",
              });
              dot._inertiaApplied = false;
            },
          });
        }
      }
    };

    let touchEndTimeout: ReturnType<typeof setTimeout> | null = null;

    const onTouchMove = (e: TouchEvent) => {
      if (isMobile()) return;
      if (touchEndTimeout) {
        clearTimeout(touchEndTimeout);
        touchEndTimeout = null;
      }
      if (e.touches && e.touches[0]) {
        onMove(e.touches[0]);
      }
    };

    const onTouchStart = (e: TouchEvent) => {
      if (isMobile()) return;
      if (touchEndTimeout) {
        clearTimeout(touchEndTimeout);
        touchEndTimeout = null;
      }
      if (e.touches && e.touches[0]) {
        onMove(e.touches[0]);
      }
    };

    const onTouchEnd = () => {
      if (isMobile()) return;
      touchEndTimeout = setTimeout(() => {
        pointer.x = -1000;
        pointer.y = -1000;
        pointer.lastX = -1000;
        pointer.lastY = -1000;
        pointer.hasMoved = false;
      }, 1000);
    };

    const onMouseLeave = () => {
      pointer.x = -1000;
      pointer.y = -1000;
      pointer.lastX = -1000;
      pointer.lastY = -1000;
      pointer.hasMoved = false;
    };

    const throttledMove = throttle(onMove, 50);
    const throttledTouchMove = throttle(onTouchMove, 50);

    window.addEventListener("mousemove", throttledMove, { passive: true });
    window.addEventListener("touchstart", onTouchStart, { passive: true });
    window.addEventListener("touchmove", throttledTouchMove, { passive: true });
    window.addEventListener("touchend", onTouchEnd, { passive: true });
    document.addEventListener("mouseleave", onMouseLeave);
    window.addEventListener("click", onClick);

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            if (!isVisible) {
              isVisible = true;
              if (isMobile()) {
                draw();
              } else {
                cancelAnimationFrame(rafId);
                rafId = requestAnimationFrame(draw);
              }
            }
          } else {
            isVisible = false;
            cancelAnimationFrame(rafId);
          }
        }
      },
      { threshold: 0.05 },
    );
    observer.observe(wrap);

    buildGrid();
    if (typeof ResizeObserver !== "undefined") {
      const ro = new ResizeObserver(buildGrid);
      ro.observe(wrap);
    } else {
      window.addEventListener("resize", buildGrid);
    }

    if (!isMobile()) {
      rafId = requestAnimationFrame(draw);
    }
  }
</script>

