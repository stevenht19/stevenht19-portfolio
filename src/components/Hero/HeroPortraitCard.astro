---
import { Image } from "astro:assets";
import mePhoto from "../../assets/me2.png";

interface Props {
  image?: ImageMetadata;
  alt?: string;
  class?: string;
}

const {
  image = mePhoto,
  alt = "Martín Hernández - Desarrollador Fullstack",
  class: className = "",
} = Astro.props;
---

<div
  class:list={[
    "relative z-10 flex items-end justify-center w-full lg:w-auto h-full max-h-[46vh] sm:max-h-[50vh] lg:max-h-[calc(100dvh-7rem)] select-none group [mask-image:linear-gradient(to_bottom,black_82%,transparent_100%)] [-webkit-mask-image:linear-gradient(to_bottom,black_82%,transparent_100%)]",
    className,
  ]}
>
  <div
    class="relative w-auto h-full max-w-57.5 xs:max-w-[260px] sm:max-w-[320px] md:max-w-[370px] lg:max-w-[430px] xl:max-w-[490px] 2xl:max-w-[530px] flex items-end justify-center"
  >
    <Image
      src={image}
      alt={alt}
      loading="eager"
      class="relative scale-135 z-10 w-auto h-full max-w-full pointer-events-none object-cover object-center drop-shadow-[0_16px_32px_rgba(0,0,0,0.85)] transition-transform lg:scale-100 duration-500 ease-out group-hover:scale-[1.1]"
    />
  </div>
</div>
