---
import ProjectCard from "./ProjectCard.astro";
import ProjectsParticles from "./ProjectsParticles";
import Button from "@components/ui/Button.astro";
import Icon from "@components/ui/Icon.astro";
import SectionEyebrow from "@components/ui/SectionEyebrow.astro";
import { PROJECTS_DATA } from "@data/projects";
import { SITE_INFO } from "@data/site";
---

<section
  id="proyectos"
  class="projects-section relative overflow-hidden border-y border-white/8 bg-zinc-950 py-24 sm:py-28 lg:py-36"
  aria-label="Proyectos destacados"
>
  <ProjectsParticles
    client:visible
    class="pointer-events-none absolute inset-0 z-0"
  />

  <div
    class="projects-glow-1 pointer-events-none absolute -left-40 top-1/4 h-130 w-130 rounded-full bg-purple-600/10 blur-[130px]"
    aria-hidden="true"
  >
  </div>
  <div
    class="projects-glow-2 pointer-events-none absolute -right-40 bottom-1/4 h-130 w-130 rounded-full bg-blue-600/10 blur-[130px]"
    aria-hidden="true"
  >
  </div>

  <div
    class="relative z-10 mx-auto max-w-7xl px-6 sm:px-9 2xl:max-w-368 2xl:px-12 3xl:max-w-[114rem] 3xl:px-16"
  >
    <header
      class="mb-16 grid gap-10 sm:mb-20 lg:grid-cols-12 lg:items-end lg:gap-14"
    >
      <div class="lg:col-span-7">
        <SectionEyebrow
          class="projects-eyebrow mb-5 opacity-0"
          label="Selección de trabajo"
          count={PROJECTS_DATA.length}
        />

        <h2
          class="projects-heading font-display font-extrabold leading-[0.92] tracking-tight text-white"
        >
          <span class="block text-[clamp(2.65rem,5vw+1rem,5.25rem)] opacity-0"
            >Proyectos</span
          >
          <span
            class="projects-heading-outline block text-[clamp(2.65rem,5vw+1rem,5.25rem)] text-transparent [-webkit-text-stroke:1.5px_rgba(212,255,0,0.60)] opacity-0"
            >destacados</span
          >
        </h2>
      </div>

      <div class="lg:col-span-5">
        <p
          class="projects-desc mb-7 max-w-lg leading-relaxed text-zinc-400 opacity-0 lg:ml-auto"
        >
          Productos reales en producción: arquitectura, APIs, interfaces y
          despliegue. Cada proyecto resuelve un problema con foco en rendimiento
          y detalle.
        </p>
        <div class="projects-cta-wrap opacity-0 lg:text-right">
          <Button
            href={SITE_INFO.socials.github.href}
            variant="secondary"
            size="md"
            data-magnetic
            class="gap-2.5"
          >
            <span>Ver todo en GitHub</span>
            <Icon
              name="external"
              class="w-3.5 h-3.5 transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
            />
          </Button>
        </div>
      </div>
    </header>

    <div class="projects-grid grid gap-5 lg:grid-cols-2 lg:gap-6">
      {PROJECTS_DATA?.map((project) => <ProjectCard project={project} />)}
    </div>
  </div>

  <div
    class="absolute bottom-0 inset-x-0 h-px bg-white/6 z-20"
    aria-hidden="true"
  >
  </div>
</section>

<script>
  import {
    gsap,
    prefersReducedMotion,
    onDomReady,
    initMagneticElements,
    setupCardTilt,
  } from "@utils/motion";

  function initProjectsAnimations() {
    const isReduced = prefersReducedMotion();

    const eyebrow = document.querySelector(".projects-eyebrow");
    const heading = document.querySelectorAll(".projects-heading span");
    const desc = document.querySelector(".projects-desc");
    const ctaWrap = document.querySelector(".projects-cta-wrap");
    const cards = gsap.utils.toArray<HTMLElement>(".project-card");
    const glow1 = document.querySelector(".projects-glow-1");
    const glow2 = document.querySelector(".projects-glow-2");

    if (!isReduced) {
      const revealTargets = [eyebrow, desc, ctaWrap].filter(
        Boolean,
      ) as gsap.TweenTarget[];

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: "#proyectos",
          start: "top 78%",
          once: true,
        },
      });

      tl.fromTo(
        revealTargets,
        { opacity: 0, y: 26, filter: "blur(5px)" },
        {
          opacity: 1,
          y: 0,
          filter: "blur(0px)",
          duration: 0.85,
          ease: "power3.out",
          stagger: 0.12,
        },
      );

      if (cards.length > 0) {
        tl.fromTo(
          cards,
          { opacity: 0, y: 64, filter: "blur(8px)" },
          {
            opacity: 1,
            y: 0,
            filter: "blur(0px)",
            duration: 0.95,
            ease: "power3.out",
            stagger: { amount: 0.35, grid: [2, 2], from: "start" },
          },
          "-=0.45",
        );
      }

      gsap.fromTo(
        ".projects-heading span",
        { opacity: 0, y: 46, filter: "blur(6px)" },
        {
          opacity: 1,
          y: 0,
          filter: "blur(0px)",
          duration: 0.9,
          ease: "power3.out",
          stagger: 0.1,
          scrollTrigger: {
            trigger: "#proyectos",
            start: "top 80%",
            once: true,
          },
        },
      );

      if (glow1 && glow2) {
        gsap.to(glow1, {
          y: "-14%",
          x: "6%",
          ease: "none",
          scrollTrigger: {
            trigger: "#proyectos",
            start: "top bottom",
            end: "bottom top",
            scrub: 1.6,
          },
        });
        gsap.to(glow2, {
          y: "18%",
          x: "-8%",
          ease: "none",
          scrollTrigger: {
            trigger: "#proyectos",
            start: "top bottom",
            end: "bottom top",
            scrub: 2,
          },
        });
      }

      cards.forEach((card) => {
        const img = card.querySelector<HTMLElement>(".project-card-img");
        if (img) {
          gsap.fromTo(
            img,
            { yPercent: -7 },
            {
              yPercent: 7,
              ease: "none",
              scrollTrigger: {
                trigger: card,
                start: "top bottom",
                end: "bottom top",
                scrub: 1.2,
              },
            },
          );
        }

        setupCardTilt(card, {
          maxTilt: 6,
          perspective: 1100,
          trackMouseVars: true,
          pixelCoords: true,
        });
      });

      if (window.matchMedia("(min-width: 1024px)").matches) {
        cards.forEach((card, index) => {
          if (index % 2 === 1) {
            gsap.to(card, {
              y: -28,
              ease: "none",
              scrollTrigger: {
                trigger: "#proyectos",
                start: "top center",
                end: "bottom top",
                scrub: 1.4,
              },
            });
          }
        });
      }

      initMagneticElements(document.getElementById("proyectos") || document);
    } else {
      gsap.set([eyebrow, ...heading, desc, ctaWrap, ...cards].filter(Boolean), {
        opacity: 1,
        y: 0,
        filter: "blur(0px)",
      });
    }
  }

  onDomReady(initProjectsAnimations);
</script>
