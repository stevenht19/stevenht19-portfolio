---
import { SITE_INFO } from "@data/site";
import { NAV_LINKS } from "@data/navigation";
import BackgroundGrid from "@components/ui/BackgroundGrid.astro";

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;

const year = new Date().getFullYear();
---

<footer
  id="footer"
  aria-label="Pie de página"
  class:list={[
    "relative overflow-hidden border-t border-white/10 bg-[#040508] text-zinc-100",
    className,
  ]}
>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -bottom-32 left-1/2 h-125 w-[85vw] max-w-6xl -translate-x-1/2 rounded-full bg-[radial-gradient(ellipse_at_center,rgba(212,255,0,0.11),rgba(52,211,153,0.03)_45%,transparent_70%)] blur-3xl"
  >
  </div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -top-40 right-10 h-95 w-95 rounded-full bg-[radial-gradient(circle,rgba(212,255,0,0.06),transparent_65%)] blur-2xl"
  >
  </div>

  <BackgroundGrid lineAlpha={0.02} opacity={60} mask="radial" />

  <div
    class="relative mx-auto max-w-7xl px-6 pt-10 pb-12 sm:px-10 sm:pt-14 sm:pb-16 2xl:max-w-368 2xl:px-12 3xl:max-w-[114rem] 3xl:px-16"
  >
    <div
      class="relative overflow-hidden select-none py-10 sm:py-16 text-center"
    >
      <div
        class="font-display font-black tracking-tighter uppercase text-[clamp(2.5rem,13vw,13rem)] leading-none text-white/4 hover:text-white/8 transition-colors duration-700 pointer-events-none"
        aria-hidden="true"
      >
        {SITE_INFO.name}
      </div>
    </div>

    <nav
      class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3 pb-12 sm:pb-16"
      aria-label="Navegación del pie de página"
    >
      {
        NAV_LINKS.map((link) => (
          <a
            href={link.href}
            class="group relative text-sm text-zinc-400 transition-colors duration-300 hover:text-primary"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div
      class="flex flex-col gap-6 pt-6 border-t border-white/8 sm:flex-row sm:items-center sm:justify-between text-xs text-zinc-500"
    >
      <div class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-6">
        <p class="font-sans">
          © {year}{" "}{SITE_INFO.name}. Todos los derechos reservados.
        </p>
        <span class="hidden sm:inline text-zinc-700">|</span>
        <p class="font-sans">Diseñado y desarrollado con precisión técnica.</p>
      </div>

      <a
        id="footer-back-to-top"
        href="#main-content"
        class="group inline-flex items-center gap-3 text-xs font-semibold text-zinc-400 transition-colors duration-300 hover:text-primary w-fit cursor-pointer"
      >
        <span class="tracking-normal font-sans text-sm">Volver arriba</span>
        <span
          class="grid h-8 w-8 place-items-center rounded-full border border-white/12 bg-white/3 transition-all duration-300 group-hover:border-primary/60 group-hover:bg-primary/10 group-hover:text-primary group-hover:-translate-y-1"
          aria-hidden="true"
        >
          <svg
            class="h-4 w-4 transition-transform duration-300"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="12" y1="19" x2="12" y2="5"></line>
            <polyline points="5 12 12 5 19 12"></polyline>
          </svg>
        </span>
      </a>
    </div>
  </div>
</footer>
