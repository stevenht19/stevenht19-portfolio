---
import { Image } from "astro:assets";
import Github from "./icons/Github.astro";
import Gmail from "./icons/Gmail.astro";
import Wsp from "./icons/Wsp.astro";
import me from "../assets/me2.png";
import Linkedln from "./icons/Linkedln.astro";
---

<section class="flex flex-col flex-1 pt-24 lg:pt-0 justify-center min-h-screen">
  <>
    <div
      class="flex flex-1 items-center justify-between animate-[scale_.8s_ease_forwards]"
    >
      <div class="flex flex-col gap-5 justify-center">
        <p class="text-white font-medium text-xl md:text-3xl">Hello!</p>
        <h1 class="text-white text-5xl md:text-6xl xl:text-7xl">
          I'm <span
            class="font-bold text-blue-200/90 animate-[fadeIn_.8s_ease-in]"
            >Martin Hernández</span
          >
        </h1>
        <p class="text-gray-400 text-lg my-5 max-w-prose">
          I'm a <span class="underline text-blue-100/90">Web Developer</span> based
          in Lima, Peru.
        </p>
        <div class="mt-5">
          <a
            href="https://wa.me/51981729976"
            target="_blank"
            class="flex w-fit items-center justify-center gap-2 py-3 px-12 md:text-md text-white font-medium border-2 border-gray-900/50 animate-[fadeIn_1.25s_ease]"
          >
            Get in Touch
            <Wsp />
          </a>
        </div>
      </div>
      {
        /* <div class="bg-gray-900/30 rounded-full overflow-hidden">
        <Image
          src={me}
          alt="Martin Steven Hernandez Developer"
          width={325}
          height={325}
          class="relative -left-7 top-7"
        />
      </div>*/
      }
    </div>
  </>
  <div class="flex items-center gap-10 py-10 mt-auto">
    <a
      href="https://github.com/stevenht19"
      target="_blank"
      title="Go to Steven's Github profile"
      class="animate-[fadeIn_1.6s_ease]"
    >
      <Github />
    </a>
    <a
      href="https://www.linkedin.com/in/martin-hernández-torres-4778a3267"
      class="animate-[fadeIn_2s_ease]"
      target="_blank"
    >
      <Linkedln />
    </a>
    <a
      href="mailto:mstvdev19@gmail.com"
      class="animate-[fadeIn_2.4s_ease]"
      target="_blank"
    >
      <Gmail />
    </a>
  </div>
</section>
