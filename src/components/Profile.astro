---
import Button from "./Button.astro";
import Github from "./icons/Github.astro";
import Gmail from "./icons/Gmail.astro";
import Linkedln from "./icons/Linkedln.astro";
---

<section class="flex flex-col flex-1 pt-24 lg:pt-0 justify-center min-h-screen">
  <div
    class="flex flex-1 flex-col justify-center gap-5 scale-95 opacity-0 animate-[scale_.8s_ease_forwards]"
  >
    <p class="text-white font-medium text-xl md:text-3xl">Hello!</p>
    <h1 class="text-white text-5xl md:text-6xl xl:text-8xl">
      I'm <span class="font-bold text-blue-100 animate-[fadeIn_.8s_ease-in]"
        >Steven.</span
      >
    </h1>
    <p class="text-gray-400 text-lg my-5 max-w-prose">
      I'm a <span class="underline">Web Developer</span> based in Lima, Peru.
    </p>
    <div class="mt-5">
      <Button title="Download Resume">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          class="fill-gray-50 mt-1"
        >
          <path d="M19 9h-4V3H9v6H5l7 8zM4 19h16v2H4z"></path>
        </svg>
      </Button>
    </div>
  </div>
  <div class="flex gap-10 py-10 mt-auto">
    <a
      href="https://github.com/stevenht19"
      title="Go to Steven's Github profile"
      class="animate-[fadeIn_1.6s_ease]"
    >
      <Github />
    </a>
    <a href="https://github.com/stevenht19" class="animate-[fadeIn_2s_ease]">
      <Linkedln />
    </a>
    <a href="https://github.com/stevenht19" class="animate-[fadeIn_2.4s_ease]">
      <Gmail />
    </a>
  </div>
</section>
