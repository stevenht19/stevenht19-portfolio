---
import { Image } from "@astrojs/image/components";
---

<section id="about" class="pt-20">
  <h2 class="text-white font-bold text-4xl pt-10 pb-2">About me</h2>
  <p class="text-gray-400 mt-4 max-w-prose">
    Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed placerat,
    lectus id maximus tempor, elit nulla pharetra dolor, eu euismod massa erat
    sed metus. Integer dolor dolor, finibus eu massa ut, dignissim ornare mi.
  </p>
  <p class="text-gray-400 mt-4 mb-10">
    I specialize in Frontend development, Also have backend knowledge.
  </p>
  <div class="flex justify-between items-center pt-5">
    <div class="bg-blue-500/10 p-3.5 rounded-full">
      <Image
        loading="lazy"
        width={30}
        height={30}
        src={'https://cdn.worldvectorlogo.com/logos/html-1.svg'}
        quality={0}
        alt='HTML logo'
      />
    </div>
    <div class="bg-blue-500/10 p-3.5 rounded-full">
      <Image 
        src={'https://upload.wikimedia.org/wikipedia/commons/thumb/6/62/CSS3_logo.svg/240px-CSS3_logo.svg.png'}
        width={30}
        height={30}
        quality={0}
        alt='CSS logo'
      />
    </div>
    <div class="bg-blue-500/10 p-3.5 rounded-full">
      <Image
        loading="lazy"
        width={30}
        height={30}
        src={"https://upload.wikimedia.org/wikipedia/commons/thumb/4/4c/Typescript_logo_2020.svg/1200px-Typescript_logo_2020.svg.png"}
        quality={0}
        alt="Typescript Logo"
      />
    </div>
    <div class="bg-blue-500/10 p-3.5 rounded-full">
      <Image 
        src={'https://astro.js.org/astro.png'}
        width={30}
        height={30}
        quality={0}
        alt="Astro Logo"
      />
    </div>
    <div class="bg-blue-500/10 p-3.5 rounded-full">
      <Image
        loading="lazy"
        src="https://upload.wikimedia.org/wikipedia/commons/thumb/a/a7/React-icon.svg/2300px-React-icon.svg.png"
        width={30}
        height={30}
        quality={0}
        alt="React Logo"
      />
    </div>
    <div class="bg-blue-500/10 p-3.5 rounded-full">
      <Image
        loading="lazy"
        src="https://seeklogo.com/images/N/nodejs-logo-FBE122E377-seeklogo.com.png"
        width={30}
        height={30}
        quality={0}
        alt="Nodejs Logo"
      />
    </div>
    <div class="bg-blue-500/10 p-3.5 rounded-full">
      <Image
        loading="lazy"
        src={"https://docs.nestjs.com/assets/logo-small.svg"}
        width={30}
        height={30}
        quality={0}
        alt="Nestjs Logo"
      />
    </div>
    <div class="bg-blue-500/10 p-3.5 rounded-full">
      <Image
        src={"https://cdn.icon-icons.com/icons2/2415/PNG/512/mongodb_original_logo_icon_146424.png"}
        width={30}
        height={30}
        quality={0}
        alt="Mongodb Logo"
      />
    </div>
    <div class="bg-blue-500/10 p-3.5 rounded-full">
      <Image 
        src={'https://www.freeiconspng.com/thumbs/sql-server-icon-png/sql-server-icon-png-29.png'}
        width={30}
        height={30}
        quality={0}
        alt="SQL Logo"
      />
    </div>
  </div>
</section>
