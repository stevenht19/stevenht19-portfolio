---
import type { ISourceOptions } from "tsparticles-engine";
import AstroParticles from 'astro-particles'

const options: ISourceOptions = {
	particles: {
    number: {
      value: 18,
      density: {
        enable: true,
        value_area: 1000
      }
    },
    color: {
      value: "#ffffff"
    },
    shape: {
      type: "circle",
      stroke: {
        width: 0,
        color: "#000000"
      },
      polygon: {
        nb_sides: 4
      },
      image: {
        src: "img/github.svg",
        width: 100,
        height: 100
      }
    },
    opacity: {
      value: 0.47300655795532925,
      random: true,
      anim: {
        enable: true,
        speed: 1,
        opacity_min: 0,
        sync: false
      }
    },
    size: {
      value: 3,
      random: true,
      anim: {
        enable: false,
        speed: 4,
        size_min: 0.3,
        sync: false
      }
    },
    line_linked: {
      enable: false,
      distance: 150,
      color: "#ffffff",
      opacity: 0.4,
      width: 1
    },
    move: {
      enable: true,
      speed: .5,
      direction: "none",
      random: true,
      straight: false,
      out_mode: "out",
      bounce: false,
      attract: {
        enable: false,
        rotateX: 600,
        rotateY: 600
      }
    }
	},
};
---
<script>
	import { tsParticles } from 'tsparticles-engine'
	import { loadFull } from 'tsparticles'
  
	(async () => {
		loadFull(tsParticles)
	})()
</script>
<AstroParticles id='ts-particles' options={options} />

